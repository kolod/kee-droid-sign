<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <RootNamespace>KeeDroidSign.Core</RootNamespace>
    <AssemblyName>KeeDroidSign.Core</AssemblyName>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <!-- Public types and non-obvious members are documented; trivial members are not. -->
    <NoWarn>$(NoWarn);CS1591</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" />
  </ItemGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="KeeDroidSign.Core.Tests" />
    <InternalsVisibleTo Include="KeeDroidSign.Tests" />
  </ItemGroup>

</Project>
